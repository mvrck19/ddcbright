<ui:FluentWindow x:Class="DdcBright.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DDCBright Settings"
                 Width="460"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ResizeMode="CanMinimize"
                 Activated="SettingsWindow_Activated">
    <StackPanel>
        <ui:TitleBar Title="DDCBright Settings" />

        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="20">
            <StackPanel>

                <!-- Appearance -->
                <TextBlock Text="Appearance" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="App theme" FontSize="13.5" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                            <UniformGrid Rows="1" Columns="3">
                                <ToggleButton x:Name="ThemeSystemBtn" Width="36" Height="28" Style="{StaticResource SegmentToggleStyle}" ToolTip="System">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="15" />
                                </ToggleButton>
                                <ToggleButton x:Name="ThemeLightBtn" Width="36" Height="28" Style="{StaticResource SegmentToggleStyle}" ToolTip="Light">
                                    <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="15" />
                                </ToggleButton>
                                <ToggleButton x:Name="ThemeDarkBtn" Width="36" Height="28" Style="{StaticResource SegmentToggleStyle}" ToolTip="Dark">
                                    <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="15" />
                                </ToggleButton>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- General -->
                <TextBlock Text="General" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Launch at startup" FontSize="13.5" VerticalAlignment="Center" />
                        <ToggleButton x:Name="LaunchAtStartupToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}"
                                      VerticalAlignment="Center" Click="LaunchAtStartupToggle_Click" />
                    </Grid>
                </Border>

                <!-- Automatic brightness -->
                <TextBlock Text="Automatic brightness" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Mode" FontSize="13.5" />
                            <TextBlock x:Name="AutoModeStatusText" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2" MinWidth="180" VerticalAlignment="Center">
                            <UniformGrid Rows="1" Columns="3">
                                <ToggleButton x:Name="AutoOffBtn" Content="Off" Style="{StaticResource SegmentToggleStyle}" />
                                <ToggleButton x:Name="AutoScheduleBtn" Content="Schedule" Style="{StaticResource SegmentToggleStyle}" />
                                <ToggleButton x:Name="AutoAmbientBtn" Content="Ambient" Style="{StaticResource SegmentToggleStyle}" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="AmbientCard" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Camera" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="AmbientCameraSelector" Grid.Column="1" Width="150" VerticalAlignment="Center"
                                      SelectionChanged="AmbientCameraSelector_SelectionChanged" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AmbientTestResultText" Grid.Column="0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="1" x:Name="AmbientTestButton" Content="Test now" Click="AmbientTestButton_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TransitionCard" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Transition" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2" MinWidth="150" VerticalAlignment="Center">
                                <UniformGrid Rows="1" Columns="2">
                                    <ToggleButton x:Name="TransitionInstantBtn" Content="Instant" Style="{StaticResource SegmentToggleStyle}" />
                                    <ToggleButton x:Name="TransitionGradualBtn" Content="Gradual" Style="{StaticResource SegmentToggleStyle}" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Grid x:Name="FadeDurationRow" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fade over" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="TransitionMinutesDown" Content="&#8722;" Style="{StaticResource StepperButtonStyle}" Click="TransitionMinutesDown_Click" />
                                <TextBlock x:Name="TransitionMinutesLabel" FontSize="13" Width="56" TextAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                                <Button x:Name="TransitionMinutesUp" Content="+" Style="{StaticResource StepperButtonStyle}" Click="TransitionMinutesUp_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="ScheduleCardsRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="14" Height="14" Fill="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Day" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Starts at" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="DayTimeDown" Content="&#8722;" Style="{StaticResource StepperButtonStyle}" Click="DayTimeDown_Click" />
                                <TextBlock Grid.Column="1" x:Name="DayTimeLabel" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" x:Name="DayTimeUp" Content="+" Style="{StaticResource StepperButtonStyle}" Click="DayTimeUp_Click" />
                            </Grid>
                            <TextBlock Text="Brightness" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                            <Grid x:Name="DayBrightnessRow" Background="Transparent" MouseWheel="DayBrightnessRow_MouseWheel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="DayBrightnessDown" Content="&#8722;" Style="{StaticResource StepperButtonStyle}" Click="DayBrightnessDown_Click" />
                                <TextBlock Grid.Column="1" x:Name="DayBrightnessLabel" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" x:Name="DayBrightnessUp" Content="+" Style="{StaticResource StepperButtonStyle}" Click="DayBrightnessUp_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Night" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Starts at" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="NightTimeDown" Content="&#8722;" Style="{StaticResource StepperButtonStyle}" Click="NightTimeDown_Click" />
                                <TextBlock Grid.Column="1" x:Name="NightTimeLabel" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" x:Name="NightTimeUp" Content="+" Style="{StaticResource StepperButtonStyle}" Click="NightTimeUp_Click" />
                            </Grid>
                            <TextBlock Text="Brightness" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                            <Grid x:Name="NightBrightnessRow" Background="Transparent" MouseWheel="NightBrightnessRow_MouseWheel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="NightBrightnessDown" Content="&#8722;" Style="{StaticResource StepperButtonStyle}" Click="NightBrightnessDown_Click" />
                                <TextBlock Grid.Column="1" x:Name="NightBrightnessLabel" FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" x:Name="NightBrightnessUp" Content="+" Style="{StaticResource StepperButtonStyle}" Click="NightBrightnessUp_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
