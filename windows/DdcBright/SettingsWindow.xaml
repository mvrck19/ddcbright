<ui:FluentWindow x:Class="DdcBright.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DDCBright Settings"
                 Width="460"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ResizeMode="CanMinimize">
    <StackPanel>
        <ui:TitleBar Title="DDCBright Settings"/>
        <StackPanel Margin="20,4,20,20">
            <TextBlock Text="Schedule" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Day" VerticalAlignment="Center"/>
                <ui:NumberBox x:Name="DayHourBox" Grid.Column="1"
                              Minimum="0" Maximum="23" ValueChanged="DayTimeBox_ValueChanged"/>
                <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ui:NumberBox x:Name="DayMinuteBox" Grid.Column="3"
                              Minimum="0" Maximum="59" ValueChanged="DayTimeBox_ValueChanged"/>
                <ui:NumberBox x:Name="DayBrightnessBox" Grid.Column="5"
                              Minimum="0" Maximum="100" SmallChange="5"
                              ValueChanged="DayBrightnessBox_ValueChanged"/>
            </Grid>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Night" VerticalAlignment="Center"/>
                <ui:NumberBox x:Name="NightHourBox" Grid.Column="1"
                              Minimum="0" Maximum="23" ValueChanged="NightTimeBox_ValueChanged"/>
                <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ui:NumberBox x:Name="NightMinuteBox" Grid.Column="3"
                              Minimum="0" Maximum="59" ValueChanged="NightTimeBox_ValueChanged"/>
                <ui:NumberBox x:Name="NightBrightnessBox" Grid.Column="5"
                              Minimum="0" Maximum="100" SmallChange="5"
                              ValueChanged="NightBrightnessBox_ValueChanged"/>
            </Grid>

            <TextBlock Text="Ambient (webcam)" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Coming soon." Opacity="0.7"/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
