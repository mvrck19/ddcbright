<ui:FluentWindow x:Class="DdcBright.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Brightness Control"
                 MinWidth="0"
                 MinHeight="0"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 Deactivated="Window_Deactivated">
    <StackPanel Width="340" Margin="16">

        <Grid x:Name="LinkMonitorsRow" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Link monitors"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <ToggleButton x:Name="LinkMonitorsToggle"
                          Grid.Column="1"
                          Style="{StaticResource PillToggleStyle}"
                          Click="LinkMonitorsToggle_Click" />
        </Grid>

        <StackPanel x:Name="MonitorRowsPanel" />

        <TextBlock Text="Auto-brightness" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2" Margin="0,0,0,8">
            <UniformGrid Rows="1" Columns="3">
                <ToggleButton x:Name="AutoOffBtn" Content="Off" Style="{StaticResource SegmentToggleStyle}" />
                <ToggleButton x:Name="AutoScheduleBtn" Content="Schedule" Style="{StaticResource SegmentToggleStyle}" />
                <ToggleButton x:Name="AutoAmbientBtn" Content="Ambient" Style="{StaticResource SegmentToggleStyle}" />
            </UniformGrid>
        </Border>
        <TextBlock x:Name="AutoStatusText"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,12" />
        <TextBlock x:Name="SettingsLink"
                   Text="Settings"
                   FontSize="13"
                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                   HorizontalAlignment="Right"
                   Cursor="Hand"
                   MouseLeftButtonUp="SettingsLink_MouseLeftButtonUp" />
    </StackPanel>
</ui:FluentWindow>
