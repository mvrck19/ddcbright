<ui:FluentWindow x:Class="DdcBright.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Brightness Control"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 Deactivated="Window_Deactivated">
    <StackPanel MinWidth="220" Margin="16,12">
        <ComboBox x:Name="MonitorSelector"
                  Margin="0,0,0,8"
                  SelectionChanged="MonitorSelector_SelectionChanged"/>
        <TextBlock x:Name="BrightnessLabel" Margin="0,0,0,8"/>
        <Slider x:Name="BrightnessSlider"
                Minimum="0" Maximum="100"
                ValueChanged="BrightnessSlider_ValueChanged"/>
    </StackPanel>
</ui:FluentWindow>
