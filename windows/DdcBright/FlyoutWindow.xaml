<ui:FluentWindow x:Class="DdcBright.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Brightness Control"
                 MinWidth="0"
                 MinHeight="0"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 Deactivated="Window_Deactivated">
    <StackPanel Width="340" Margin="16">

        <!-- Compact icon-only header: both are utility controls (not
             brightness content itself), so they share one row in the
             top-right corner instead of each claiming a full-width row of
             their own. LinkMonitorsToggle used to sit in its own row with
             a text label, and Settings used to sit alone at the bottom
             behind a divider. -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="LinkMonitorsToggle"
                          Grid.Column="1"
                          Style="{StaticResource PillToggleStyle}"
                          ToolTip="Link monitors"
                          Visibility="Collapsed"
                          Margin="0,0,10,0"
                          Click="LinkMonitorsToggle_Click" />
            <ui:Button x:Name="SettingsButton"
                       Grid.Column="2"
                       Appearance="Transparent"
                       Icon="{ui:SymbolIcon Symbol=Settings24}"
                       ToolTip="Settings"
                       Padding="6"
                       Click="SettingsButton_Click" />
        </Grid>

        <StackPanel x:Name="MonitorRowsPanel" />

        <!-- Hidden entirely when Off: an inactive-auto-brightness row has
             nothing to glance at, just clutter, so this section only earns
             its place in the flyout while Schedule/Ambient is actually
             doing something. -->
        <StackPanel x:Name="AutoBrightnessSection">
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Auto-brightness" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <!-- Read-only status, not a control: Schedule/Ambient apply the moment
                     they're selected (BrightnessScheduler/AmbientLightSensor start on
                     TimeSpan.Zero), so a clickable mode switch here risked an accidental
                     snap in a quick popup. Changing mode now lives only in Settings. -->
                <TextBlock Grid.Column="1" x:Name="AutoModeBadgeText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="AutoStatusText"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
