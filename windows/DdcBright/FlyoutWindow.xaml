<ui:FluentWindow x:Class="DdcBright.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Brightness Control"
                 MinWidth="0"
                 MinHeight="0"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 Deactivated="Window_Deactivated">
    <StackPanel Width="240" Margin="16,12">
        <ComboBox x:Name="MonitorSelector"
                  Margin="0,0,0,8"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="MonitorSelector_SelectionChanged"/>
        <TextBlock x:Name="BrightnessLabel" Margin="0,0,0,8"/>
        <Slider x:Name="BrightnessSlider"
                Margin="0,0,0,12"
                Minimum="0" Maximum="100"
                ValueChanged="BrightnessSlider_ValueChanged"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Auto" Width="50" VerticalAlignment="Center"/>
            <ComboBox x:Name="AutoModeSelector"
                      Width="182"
                      SelectionChanged="AutoModeSelector_SelectionChanged">
                <ComboBoxItem Content="Off"/>
                <ComboBoxItem Content="Schedule"/>
                <ComboBoxItem Content="Ambient (webcam)"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Theme" Width="50" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeSelector"
                      Width="182"
                      SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
        </StackPanel>

        <Button Content="Settings…"
                HorizontalAlignment="Right"
                Padding="8,4"
                Click="SettingsButton_Click"/>
    </StackPanel>
</ui:FluentWindow>
