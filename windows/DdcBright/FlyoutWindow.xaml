<ui:FluentWindow x:Class="DdcBright.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Brightness Control"
                 MinWidth="0"
                 MinHeight="0"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 Topmost="True"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 Deactivated="Window_Deactivated">
    <StackPanel Width="290" Margin="14">

        <!-- Compact icon toolbar: utility/mode controls, not brightness
             content itself, so they all share one row in the top-right
             corner instead of each claiming a full-width row of their own
             (Settings and Link monitors used to). Schedule/Ambient here are
             a deliberate exception to the old "mode switch stays in
             Settings only" rule; see AutoModeBadgeText's comment below. -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton x:Name="ScheduleModeToggle"
                              Style="{StaticResource IconToggleStyle}"
                              ToolTip="Schedule (click again to turn off)"
                              Click="ScheduleModeToggle_Click">
                    <ui:SymbolIcon Symbol="Clock24" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="AmbientModeToggle"
                              Style="{StaticResource IconToggleStyle}"
                              ToolTip="Ambient (click again to turn off)"
                              Margin="4,0,0,0"
                              Click="AmbientModeToggle_Click">
                    <ui:SymbolIcon Symbol="Camera24" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="LinkMonitorsToggle"
                              Style="{StaticResource IconToggleStyle}"
                              ToolTip="Link monitors"
                              Visibility="Collapsed"
                              Margin="4,0,0,0"
                              Click="LinkMonitorsToggle_Click">
                    <ui:SymbolIcon Symbol="Link24" FontSize="16" />
                </ToggleButton>
                <ui:Button x:Name="SettingsButton"
                           Width="30" Height="30" Padding="0"
                           Appearance="Transparent"
                           ToolTip="Settings"
                           Margin="4,0,0,0"
                           Click="SettingsButton_Click">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="MonitorRowsPanel" />

        <!-- Hidden entirely when Off: an inactive-auto-brightness row has
             nothing to glance at, just clutter, so this section only earns
             its place in the flyout while Schedule/Ambient is actually
             doing something. -->
        <StackPanel x:Name="AutoBrightnessSection">
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Auto-brightness" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <!-- Read-only status, not a control: stays a plain label rather
                     than a second way to switch modes. The header's Schedule/
                     Ambient icons are the actual quick control now: bigger,
                     clearly iconified targets, less prone to a stray-click
                     snap than this small badge would be. -->
                <TextBlock Grid.Column="1" x:Name="AutoModeBadgeText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="AutoStatusText"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
