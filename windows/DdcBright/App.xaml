<Application x:Class="DdcBright.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DdcBright"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Design tokens (see design_handoff_windows_flyout_redesign) mapped onto
                 WPF-UI's own theme-adaptive Fluent resources (found by dumping
                 Application.Resources under Light/Dark at runtime) rather than fixed hex
                 values, so custom controls stay readable when the user picks Dark;
                 the doc's literal palette is a light-theme snapshot, not a spec that
                 should override the app's existing System/Light/Dark theme support.
                 Accent stays bound to SystemAccentColorPrimaryBrush, as before. -->

            <DropShadowEffect x:Key="SegmentActiveShadowEffect"
                               Color="Black" Opacity="0.15" BlurRadius="4" ShadowDepth="1" Direction="270" />
            <DropShadowEffect x:Key="CardShadowEffect"
                               Color="Black" Opacity="0.04" BlurRadius="3" ShadowDepth="1" Direction="270" />

            <!-- Settings-window card: a plain Border rather than ui:CardControl, since
                 CardControl (a ButtonBase with one Header+Content row) can't host the
                 Transition/Day/Night cards' extra rows; this stays one consistent shape
                 for every card instead of mixing two card mechanisms. -->
            <Style x:Key="SettingsCardStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Shared pill-segment style used by the Off/Schedule/Ambient and
                 Instant/Gradual segmented controls (flyout + settings). -->
            <Style x:Key="SegmentToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="0,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="SegmentBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                                    <Setter TargetName="SegmentBorder" Property="Effect" Value="{StaticResource SegmentActiveShadowEffect}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared ±22px stepper button style (time/brightness/transition-minutes steppers). -->
            <Style x:Key="StepperButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small 28x16 pill toggle used for "Link monitors". -->
            <Style x:Key="PillToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Track" CornerRadius="8" Background="{DynamicResource ControlStrokeColorSecondaryBrush}">
                                <Border x:Name="Thumb"
                                        Width="12" Height="12" CornerRadius="6"
                                        Background="White"
                                        HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Standalone icon button/toggle used by the flyout's header row
                 (Schedule, Ambient, Link monitors, Settings). Unlike
                 SegmentToggleStyle, each one is a self-contained square
                 rather than sharing a border with siblings in a UniformGrid. -->
            <Style x:Key="IconToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="IconBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
